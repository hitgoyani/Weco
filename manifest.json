{
  "manifest_version": 3,
  "name": "Local Web QA Copilot",
  "version": "1.2.0",
  "minimum_chrome_version": "116",
  "description": "Local-first website QA with evidence-backed findings, privacy-aware reports, and regression baselines.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite",
    "sidePanel"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Local Web QA Copilot",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
